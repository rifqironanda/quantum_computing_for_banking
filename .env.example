# Optional full benchmark endpoint. Use /api/benchmark only with npm run dev proxy.
VITE_BENCHMARK_API_URL=
# Optional authenticated report backend; localStorage is used when empty.
VITE_REPORT_API_URL=
# Supabase report workspace. Use the browser-safe publishable key, never service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
