# Qiskit service: HTTPS origin or complete /api/benchmark URL.
# Production has no localhost fallback; local npm run dev uses the Vite proxy.
VITE_BENCHMARK_API_URL=
# Easiest: your ONE existing Google Docs URL, no OAuth/Cloud project required.
VITE_REPORT_DOCUMENT_URL=
# Optional: FastAPI origin WITHOUT /api, when no direct document URL is set.
# In local development, empty uses Vite's /api proxy.
VITE_REPORT_API_URL=
